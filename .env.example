# MySQL natif. Le mot de passe et l'utilisateur sont ceux de ta machine.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/webhook_relay

# Secret HS256, au moins 32 caractères. Ne pas committer la vraie valeur.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Durée de vie du JWT en secondes (défaut : 24 h).
JWT_TTL_SECS=86400

BIND_ADDR=0.0.0.0:8080

# Worker de livraison.
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=20

# Timeout d'un POST sortant vers un endpoint client.
HTTP_TIMEOUT_SECS=10

# Nombre maximal de tentatives avant le statut exhausted.
# Backoff après chaque échec : 30s, 2min, 10min, 1h, 6h.
MAX_DELIVERY_ATTEMPTS=6

# Bail posé sur une tentative pendant l'appel HTTP, pour éviter un double envoi.
# Doit rester supérieur à HTTP_TIMEOUT_SECS.
CLAIM_LEASE_SECS=60

RUST_LOG=webhook_relay=info,tower_http=info
