  "query": "\n        SELECT\n            d.event_id,\n            d.attempt_count,\n            d.endpoint_url,\n            e.secret,\n            ev.event_type,\n            ev.payload\n        FROM delivery_attempts d\n        INNER JOIN endpoints e ON e.id = d.endpoint_id\n        INNER JOIN events ev ON ev.id = d.event_id\n        WHERE d.id = ?\n        ",
